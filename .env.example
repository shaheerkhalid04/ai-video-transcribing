# Copy this file to ".env" and paste in your real API keys.
# Do NOT commit your real .env file.
#
# All three services have a free tier, so you can run this without paying.

# Groq - runs the agent's tool calling ("brain").
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Google Gemini - transcribes the video.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# SerpApi - searches YouTube for a video.
# Get a free key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here
